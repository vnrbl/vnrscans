# ===========================================
# Email / Notifications Configuration
# ===========================================

# REQUIRED for sending emails (new user alerts + contact form)
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email address that will RECEIVE the notifications
OWNER_EMAIL=creator@vnrscans.com

# Optional: customize the "From" address
FROM_EMAIL="VNR Scans <onboarding@resend.dev>"

# ===========================================
# Cloudflare Worker (recommended for emails)
# ===========================================

# When set, the Next.js API routes will forward email requests to the Worker
# Deploy worker with: npm run cf:deploy
# Then set this to your Worker URL, e.g. https://vnrscans.yourname.workers.dev
WORKER_URL=https://vnrscans.your-subdomain.workers.dev

# ===========================================
# Webhook security (recommended for production)
# ===========================================

# Used to secure /api/webhooks/new-user when triggered by Supabase Database Webhooks
WEBHOOK_SECRET=your-super-secret-webhook-token-here

# ===========================================
# Supabase (already used by the project)
# ===========================================
# NEXT_PUBLIC_SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Site URL used in emails (optional)
NEXT_PUBLIC_SITE_URL=https://vnrscans.com

# ===========================================
# Cloudflare Worker Upload Protection (optional)
# ===========================================
# If you use the /assets/upload endpoint, protect it:
# npx wrangler secret put WORKER_UPLOAD_SECRET
# WORKER_UPLOAD_SECRET=long-random-value

# Public worker URL (only if you want the browser to call Worker directly)
# NEXT_PUBLIC_WORKER_URL=https://vnrscans.yourname.workers.dev
